{% set classes = [
  'card',
  'bg-green-100',
  'text-xl',
  'p-4',
  'font-rubik-wet',
] %}

<div {{ attributes.addClass(classes) }}>

  {% block imageSlot %}
    {% if image %}
      <div class="card__image">{{ image }}</div>
    {% endif %}
  {% endblock %}

  <div class="card__body">
    {% if card_title %}
      <h2 class="text-2xl">{{ card_title }}</h2>
    {% endif %}
    {% if description %}
      {{ description }}
    {% endif %}
  </div>

  {% if footer %}
    <div class="card__footer">{{ footer }}</div>
  {% endif %}

</div>
