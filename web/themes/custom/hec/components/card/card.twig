{% set classes = [
  'card',
  'bg-green-100',
  'text-xl',
  'p-28',
  'rounded-md',
  'flex',
] %}

<div {{ attributes.addClass(classes) }}>

  {% block imageSlot %}
    {% if image %}
      <div class="card__image {{ reverse }}">{{ image }}</div>
    {% endif %}
  {% endblock %}

  <div>
    <div class="card__body">
      {% if card_title %}
        <h2 class="text-2xl font-rubik-wet">{{ card_title }}</h2>
      {% endif %}
      {% if description %}
        {{ description }}
      {% endif %}
    </div>

    {% if footer %}
      <div class="card__footer">{{ footer }}</div>
    {% endif %}
  </div>

</div>
